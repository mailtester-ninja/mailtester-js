{
  "name": "@mailtester-ninja/client",
  "version": "1.0.0",
  "description": "Official client for the MailTester Ninja email verification API: check in real time if an email address is valid and deliverable.",
  "keywords": [
    "email",
    "email-verification",
    "email-validation",
    "email-verifier",
    "email-checker",
    "smtp",
    "catch-all",
    "disposable-email",
    "mailtester",
    "api-client"
  ],
  "homepage": "https://mailtester.ninja/api/",
  "bugs": {
    "url": "https://github.com/mailtester-ninja/mailtester-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailtester-ninja/mailtester-js.git"
  },
  "license": "MIT",
  "author": "MailTester Ninja (https://mailtester.ninja)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node18",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
